<p>{{ t(key="email.greeting") }} {{ user_name | default(value="there") }},</p>

<p>{{ t(key="email.password_reset.instruction") }}</p>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" class="btn btn-danger">
  <tbody>
    <tr>
      <td align="left">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0">
          <tbody>
            <tr>
              <td><a href="{{ reset_url | safe }}" target="_blank">{{ t(key="email.password_reset.button") }}</a></td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>

<p>{{ t(key="email.link.fallback") }}</p>
<p class="code-block">{{ reset_url | safe }}</p>

<div class="alert">
  {{ t(key="email.password_reset.expiry_notice") }}
</div>