<p>{{ t(key="email.greeting") }} {{ user_name | default(value="there") }},</p>

<p>{{ t(key="email.password_reset.instruction") }}</p>

<p style="text-align: center; margin: 32px 0;">
    <a href="{{ reset_url | safe }}" class="button button-danger">{{ t(key="email.password_reset.button") }}</a>
</p>

<p>{{ t(key="email.link.fallback") }}</p>
<p class="code-block">{{ reset_url | safe }}</p>

<div class="alert">
    {{ t(key="email.password_reset.expiry_notice") }}
</div>
