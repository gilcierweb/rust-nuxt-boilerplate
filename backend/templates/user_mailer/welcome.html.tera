<p>{{ t(key="email.greeting") }} <strong>{{ user_name | default(value="there") }}</strong>,</p>

<p>{{ t(key="email.welcome.heading", app_name=app_name) }}</p>

<p>{{ t(key="email.welcome.instruction") }}</p>

<p style="text-align: center; margin: 32px 0;">
    <a href="{{ confirm_url | safe }}" class="button">{{ t(key="email.confirmation.button") }}</a>
</p>

<p>{{ t(key="email.link.fallback") }}</p>
<p class="code-block">{{ confirm_url | safe }}</p>

<div class="alert">
    {{ t(key="email.welcome.expiry_notice") }}
</div>
